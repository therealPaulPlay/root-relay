# Port
PORT = "3013"

# Redirect to official update server
REDIRECT_UPDATES = "true"

# S3 (DigitalOcean Spaces) is used for pulling the firmware updates
# Only required if you choose not to redirect
S3_ACCESS_KEY_ID = "my-access-key-id"
S3_SECRET_ACCESS_KEY = "my-access-key"
S3_BUCKET_NAME = "my-bucket"
S3_DOMAIN = "my-spaces-domain.com"
S3_REGION = "fra1"
